POSTGRES_PORT=5433
# Copy to .env (git-ignored) and adjust. Never commit a real .env.
# Every value below is a local-development placeholder, not a secret.

# --- PostgreSQL (read by docker-compose.yml) ---
POSTGRES_DB=getabursary
POSTGRES_USER=getabursary
POSTGRES_PASSWORD=localdev

# --- Application settings (ASP.NET Core / Worker use __ for nesting) ---
ConnectionStrings__Default=Host=localhost;Port=5433;Database=getabursary;Username=getabursary;Password=localdev

# LLM extraction API key: replace with your own key, keep it out of git.
Extraction__ApiKey=replace-me

# Salt for hashing IP addresses in reports (store a long random value locally).
Reports__IpHashSalt=replace-me
