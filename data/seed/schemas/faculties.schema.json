{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getabursary.co.za/schemas/seed/faculties.schema.json",
  "title": "Faculties and qualifications for one institution (reference seed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["institutionSlug", "sourceUrls", "faculties"],
  "properties": {
    "$schema": { "type": "string" },
    "institutionSlug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100 },
    "sourceUrls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 300 }
    },
    "faculties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "slug", "qualifications"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100 },
          "qualifications": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "studyLevel", "slug", "fieldCodes"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                "abbreviation": { "type": "string", "minLength": 1, "maxLength": 50 },
                "studyLevel": { "type": "string", "enum": ["Matric", "Undergraduate", "Honours", "Masters", "Doctoral"] },
                "nqfLevel": { "type": "integer", "minimum": 1, "maximum": 10 },
                "durationYears": { "type": "integer", "minimum": 1, "maximum": 8 },
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 100 },
                "fieldCodes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[0-9]{2}$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
