# Trust Cloudflare's edge so Caddy keeps the real client IP in X-Forwarded-For.
# Ranges from https://www.cloudflare.com/ips/ ; refresh if Cloudflare changes them.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Cloudflare (SSL mode "Full") talks HTTPS to Caddy, which uses its own self-signed cert (tls internal),
# so there is no certificate to create by hand. shortcut: switch to a Cloudflare Origin cert + "Full (strict)" for prod.
www.{$SITE_DOMAIN} {
	tls internal
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@api path /api/* /signin-google*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:4000
	}
}
