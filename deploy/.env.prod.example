# Copy to /opt/getabursary/.env on the server (chmod 600). Placeholders only: never commit real values.

# Environment name. Production enables SMTP email and secure cookies.
ASPNETCORE_ENVIRONMENT=Production

# Public domain without www; Caddy serves it and redirects www to it.
SITE_DOMAIN=example.co.za

# Neon pooled host, SSL required. Secret.
ConnectionStrings__Default=Host=ep-example-pooler.eu-central-1.aws.neon.tech;Database=getabursary;Username=changeme;Password=changeme;SSL Mode=Require

# Public site URL, used in email links and OAuth redirects.
App__PublicBaseUrl=https://example.co.za

# Comma-separated emails that get the Admin role on startup/migrate.
Admin__Emails=admin@example.co.za

# Google OAuth client (leave empty to disable Google sign-in). Secret.
Auth__Google__ClientId=changeme.apps.googleusercontent.com
Auth__Google__ClientSecret=changeme

# SMTP for confirmation and reset emails (Brevo). Host and From are required. Secret.
Email__Smtp__Host=smtp-relay.example.com
Email__Smtp__Port=587
Email__Smtp__User=changeme
Email__Smtp__Password=changeme
Email__Smtp__From=no-reply@example.co.za

# Eligibility extraction: "fake" (no LLM calls) or "anthropic". ApiKey is a secret.
Extraction__Provider=fake
Extraction__Model=claude-haiku-5-5
Extraction__ApiKey=changeme

# Random string used to hash reporter IPs. Secret; do not change once set.
Reports__IpHashSalt=changeme-long-random-string

# Optional: image tag to deploy (the deploy workflow sets it). Defaults to latest.
# IMAGE_TAG=latest
